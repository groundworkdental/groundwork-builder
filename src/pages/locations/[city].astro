---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABlock from '../../components/CTABlock.astro';
import { site, doctor, address, localBusinessSchema } from '../../config/site';

// Location pages are opt-in and must be backed by real content.
//
// This previously shipped a hardcoded "Sample City" page, so every rebuilt site
// went live with a placeholder location page — while practices that had genuine
// neighborhood pages lost them. An empty list generates no routes at all, which
// is the correct default: a location page with nothing but a templated sentence
// is a doorway page, and the practice's own local pages should be ported rather
// than regenerated.
//
// To enable: add entries here with real, practice-specific copy.
//
// The list lives inside getStaticPaths because Astro hoists that function into
// its own chunk at build time — it cannot close over module-scope bindings.
export function getStaticPaths() {
  const nearbyLocations: Array<{ city: string; slug: string; distance: string }> = [];

  return nearbyLocations.map(({ city, slug, distance }) => ({
    params: { city: slug },
    props: { cityName: city, distance },
  }));
}

const { cityName, distance } = Astro.props;
---

<BaseLayout
  title={`Dentist Near ${cityName} — ${site.name}`}
  description={`Looking for a dentist near ${cityName}? ${site.name} is just ${distance} away. Call ${site.phone} to schedule.`}
  schema={localBusinessSchema}
>
  <section class="bg-surface-2">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
      <div class="max-w-3xl">
        <h1 class="section-heading mb-6">Dentist Near {cityName}</h1>
        <p class="text-lg text-neutral-mid leading-relaxed mb-8">
          {site.name} proudly serves patients from {cityName} and surrounding areas. Our office in {address.city} is just {distance} away, offering comprehensive dental care with a patient-first approach.
        </p>
        <a href="/schedule" class="btn-primary text-base px-8 py-4">
          Book Appointment
        </a>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-subheading mb-4">Why {cityName} Patients Choose Us</h2>
      <ul class="space-y-3 text-neutral-mid">
        <li>Conveniently located just {distance} from {cityName}</li>
        <li>Comprehensive services from cleanings to implants</li>
        <li>{doctor.name}, {doctor.credentials} — [X]+ years of experience</li>
        <li>Most insurance plans accepted</li>
        <li>Flexible scheduling including select evenings</li>
      </ul>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <CTABlock phone={site.phone} heading={`Ready to Visit From ${cityName}?`} />
    </div>
  </section>
</BaseLayout>
