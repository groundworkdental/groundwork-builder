---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  articleAuthor?: string;
  articleDate?: string;
  schema?: object | object[];
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage = '/images/branding/og-default.jpg',
  ogType = 'website',
  articleAuthor,
  articleDate,
  schema,
  noindex = false,
} = Astro.props;

/**
 * A preview deployment must never be indexed.
 *
 * Cloudflare sets CF_PAGES_BRANCH at build time, so the build itself knows
 * whether it is production — which matters because most pages are prerendered
 * and cannot inspect the request host at runtime. Any branch other than the
 * production one is treated as a preview.
 *
 * This is also what makes it defensible to build a preview from imagery found
 * on the practice's existing site before rights are confirmed: the preview is
 * never published to search. See the imagery policy in
 * docs/engineering/generator-rules.md.
 */
const productionBranch = import.meta.env.PUBLIC_PRODUCTION_BRANCH || 'main';
const buildBranch = import.meta.env.CF_PAGES_BRANCH || '';
const isPreviewBuild = Boolean(buildBranch) && buildBranch !== productionBranch;

const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = new URL(ogImage, Astro.site).href;
const ga4Id = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID;

const schemaArray = schema ? (Array.isArray(schema) ? schema : [schema]) : [];

// WebMCP: declare agent-callable actions for this site.
// Consumed by the Lighthouse Agentic Browsing audit (Chrome 150+ / Lighthouse 13.3+).
// The /.well-known/webmcp.json file (generated by pipeline) is the canonical source;
// this inline declaration adds per-page discoverability for agents that read <head>.
const webmcpTools = JSON.stringify({
  tools: [
    {
      name:        'book_appointment',
      description: `Book an appointment with ${site.name}`,
      action:      { type: 'navigate', href: '/schedule' },
    },
    {
      name:        'call_practice',
      description: `Call ${site.name} at ${site.phone}`,
      action:      { type: 'navigate', href: `tel:${site.phone.replace(/\D/g, '')}` },
    },
    {
      name:        'contact_practice',
      description: `Contact ${site.name}`,
      action:      { type: 'navigate', href: '/contact' },
    },
    {
      name:        'view_services',
      description: `View all services at ${site.name}`,
      action:      { type: 'navigate', href: '/services' },
    },
  ],
});

// Auto-generate BreadcrumbList from URL path
const pathSegments = Astro.url.pathname.replace(/\/$/, '').split('/').filter(Boolean);
const breadcrumbSchema = pathSegments.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': 'Home',
      'item': site.url,
    },
    ...pathSegments.map((seg, i) => ({
      '@type': 'ListItem',
      'position': i + 2,
      'name': seg.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase()),
      'item': `${site.url}/${pathSegments.slice(0, i + 1).join('/')}`,
    })),
  ],
} : null;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
  publisher: {
    '@type': 'Organization',
    name: site.name,
    url: site.url,
  },
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    {(noindex || isPreviewBuild) && <meta name="robots" content="noindex, nofollow" />}
    {articleAuthor && <meta name="author" content={articleAuthor} />}
    {articleDate && <meta name="date" content={articleDate} />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/images/branding/logo.png" />

    <!-- Web fonts — injected by pipeline from design phase (google | fontshare) -->
    [FONTS_PRECONNECT]
    <link href="[GOOGLE_FONTS_URL]" rel="stylesheet" />

    <!-- JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {schemaArray.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}

    <!-- WebMCP: agent-callable action declarations -->
    <script type="application/json" id="webmcp-tools" set:html={webmcpTools} />

    <!-- Google Analytics 4 -->
    {ga4Id && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
        <script define:vars={{ ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', ga4Id);

          // phone_click conversion event — fires when any tel: link is clicked
          // anywhere on the site. Sole conversion signal for Google Ads Smart
          // Bidding on calls (the #1 conversion action for dental practices).
          //
          // Event params:
          //   phone_number   — the dialed number (digits only, after stripping "tel:")
          //   page_path      — path of the page the click happened on (attribution)
          //   click_location — which UI region: 'header' | 'footer' | element's
          //                    data-phone-location attribute, or 'body' fallback
          document.addEventListener('click', (event) => {
            const link = event.target.closest('a[href^="tel:"]');
            if (!link) return;
            const phone = link.getAttribute('href').replace(/^tel:/, '').trim();
            const location =
              link.dataset.phoneLocation ||
              link.closest('header')?.tagName?.toLowerCase() ||
              link.closest('footer')?.tagName?.toLowerCase() ||
              'body';
            gtag('event', 'phone_click', {
              phone_number: phone,
              page_path: window.location.pathname,
              click_location: location,
            });
          });

          // form_submit conversion event — fires when any <form> is submitted
          // anywhere on the site. Second-most-important conversion signal after
          // phone calls for local service businesses; many patients book through
          // a contact form rather than calling.
          //
          // Event params:
          //   form_id           — form's id, name, or data-form-id (no PII)
          //   form_action       — the form's action="" URL if set
          //   page_path         — path of the page the submit happened on
          //   submit_location   — UI region: 'header' | 'footer' | element's
          //                       data-form-location attribute, or 'body' fallback
          //
          // Privacy: we NEVER read form field values. Only structural metadata
          // (id/name/action). Opt-out: add `data-no-track="true"` to a form.
          document.addEventListener('submit', (event) => {
            const form = event.target.closest('form');
            if (!form) return;
            if (form.dataset.noTrack === 'true' || form.dataset.noTrack === '') return;
            const formId = form.id || form.getAttribute('name') || form.dataset.formId || '';
            const location =
              form.dataset.formLocation ||
              form.closest('header')?.tagName?.toLowerCase() ||
              form.closest('footer')?.tagName?.toLowerCase() ||
              'body';
            gtag('event', 'form_submit', {
              form_id: formId,
              form_action: form.getAttribute('action') || '',
              page_path: window.location.pathname,
              submit_location: location,
            });
          });

          // schedule_click conversion event — fires when any link to /schedule
          // (or any link explicitly marked data-schedule-link) is clicked.
          // Captures patients who choose "Book Appointment" CTAs over calling
          // — the third major conversion path for dental practices alongside
          // phone calls and contact-form submissions.
          //
          // Event params:
          //   destination       — href the user is heading to (full URL)
          //   page_path         — path of the page the click happened on
          //   click_location    — UI region: 'header' | 'footer' | element's
          //                       data-schedule-location attribute, or 'body' fallback
          //
          // For 3rd-party schedulers (Dentrix, RevenueWell, etc.) the site
          // author opts a link in by adding data-schedule-link to the <a>.
          document.addEventListener('click', (event) => {
            const link = event.target.closest('a');
            if (!link) return;
            const href = link.getAttribute('href') || '';
            const isSchedule =
              /^\/schedule(\/|$|\?|#)/.test(href) ||
              link.dataset.scheduleLink === 'true' ||
              link.dataset.scheduleLink === '';
            if (!isSchedule) return;
            const location =
              link.dataset.scheduleLocation ||
              link.closest('header')?.tagName?.toLowerCase() ||
              link.closest('footer')?.tagName?.toLowerCase() ||
              'body';
            gtag('event', 'schedule_click', {
              destination: href,
              page_path: window.location.pathname,
              click_location: location,
            });
          });
        </script>
      </>
    )}
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  </head>
  <body class="bg-white">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
