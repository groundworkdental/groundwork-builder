{
  "name": "groundwork-builder",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node scripts/pipeline/build-site.js",
    "docs": "node scripts/pipeline/lib/skill-catalog.js && open docs/PIPELINE.html",
    "docs:rebuild": "node scripts/pipeline/lib/skill-catalog.js",
    "docs:watch": "node scripts/pipeline/lib/skill-catalog.js --watch",
    "checklist:pdf": "node scripts/resources/export-checklist-pdf.js",
    "sourcing:anchors": "node scripts/sourcing/lib/capture-anchors.js",
    "sourcing:spike": "node scripts/sourcing/spike/vendor-detect.js",
    "sourcing:run": "node scripts/sourcing/run.js",
    "sourcing:run:dry": "node scripts/sourcing/run.js --limit 10 --no-db",
    "sourcing:metros": "node scripts/sourcing/run.js --list-metros",
    "sourcing:campaign": "node scripts/sourcing/campaign.js",
    "sourcing:promote": "node scripts/sourcing/promote.js",
    "audit": "node scripts/pipeline/audit-site.js",
    "audit:precall": "node scripts/pipeline/audit-site.js --precall",
    "catalog:prompt": "node scripts/design-catalog/make-paste-prompt.mjs",
    "catalog:ingest": "node scripts/design-catalog/ingest-reference.mjs",
    "catalog:eval": "node scripts/design-catalog/eval-entry.mjs",
    "catalog:fixture": "node scripts/design-catalog/make-fixture.mjs",
    "db:migrate": "node --env-file=.env scripts/legacy/migrate-to-d1.mjs",
    "db:schema": "npx wrangler d1 execute groundwork-ops --file=scripts/pipeline/lib/d1-schema.sql --remote",
    "ops:deploy": "node --env-file=.env scripts/pipeline/ops-wrangler.mjs deploy",
    "ops:dev": "node --env-file=.env scripts/pipeline/ops-wrangler.mjs dev",
    "dashboard": "node scripts/generate-practice-dashboard.js",
    "test": "node scripts/pipeline/_test/run-offline.mjs",
    "eval:batch": "node --env-file=.env scripts/pipeline/eval-batch.js",
    "test:fixtures": "node scripts/pipeline/_test/test-fixtures.js",
    "smoke:d1": "node --env-file=.env scripts/pipeline/_test/smoke-d1.mjs",
    "smoke": "node --env-file=.env scripts/pipeline/_test/smoke-operable.mjs",
    "grade": "node --env-file=.env scripts/pipeline/grade-site.js",
    "grade:fast": "node --env-file=.env scripts/pipeline/grade-site.js --no-pagespeed",
    "grade:deploy": "npx wrangler deploy --config workers/grade-my-site/wrangler.toml",
    "grade:dev": "npx wrangler dev --config workers/grade-my-site/wrangler.toml",
    "legacy:migrate-supabase": "node scripts/legacy/migrate-supabase-export.js",
    "legacy:migrate-airtable-crm": "node --env-file=.env scripts/legacy/migrate-airtable-crm.mjs",
    "legacy:migrate-airtable-sourced": "node --env-file=.env scripts/legacy/migrate-airtable-sourced.mjs",
    "prune:clients": "node scripts/pipeline/_test/prune-client-dupes.mjs",
    "prune:clients:apply": "node scripts/pipeline/_test/prune-client-dupes.mjs --apply",
    "verify": "node scripts/pipeline/verify-build.js",
    "verify:silver": "node scripts/pipeline/verify-silver.js",
    "check:content": "node scripts/check-content.mjs",
    "check:content:built": "node scripts/check-content.mjs --built",
    "log": "node --env-file=.env scripts/log.mjs",
    "mail": "node --env-file=.env scripts/mail.mjs",
    "verify:ready": "node scripts/pipeline/verify-ready.js",
    "tg": "node --env-file=.env scripts/tg.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@astrojs/sitemap": "^3.2.1",
    "@google-cloud/storage": "^7.19.0",
    "@tailwindcss/vite": "^4.2.4",
    "astro": "^6.3.1",
    "glob": "^13.0.6",
    "gsap": "^3.15.0",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "dotenv": "^16.6.1",
    "lighthouse": "^13.3.0",
    "marked": "^18.0.3",
    "pg": "^8.20.0",
    "playwright": "^1.59.1",
    "wrangler": "^3.0.0"
  }
}
